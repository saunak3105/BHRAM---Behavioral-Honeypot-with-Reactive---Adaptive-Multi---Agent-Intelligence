# ─────────────────────────────────────────────────────────────────────────────
# BHRAM Environment Configuration — EXAMPLE FILE
# Copy this file to .env and fill in values for your local lab environment.
# NEVER commit the actual .env file. All values here are fictional/placeholder.
# ─────────────────────────────────────────────────────────────────────────────

# ── Project ───────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=bhram
ENVIRONMENT=development

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bhram_db
POSTGRES_USER=bhram_user
POSTGRES_PASSWORD=CHANGE_ME_local_dev_only

# ── BHRAM API ─────────────────────────────────────────────────────────────────
BHRAM_API_HOST=0.0.0.0
BHRAM_API_PORT=8000
BHRAM_API_SECRET_KEY=CHANGE_ME_not_a_real_secret
BHRAM_API_DEBUG=true

# ── Cowrie SSH Honeypot ───────────────────────────────────────────────────────
COWRIE_SSH_PORT=2222
COWRIE_LOG_PATH=./data/cowrie/logs

# ── Fake Web Application ──────────────────────────────────────────────────────
WEB_PORT=8080

# ── File Server ───────────────────────────────────────────────────────────────
FILESERVER_PORT=8081
FILESERVER_ROOT=/srv/company-files

# ── Network ───────────────────────────────────────────────────────────────────
FRONTEND_SUBNET=172.20.0.0/24
BACKEND_SUBNET=172.21.0.0/24
INTERNAL_SUBNET=172.22.0.0/24

# ── Safety ────────────────────────────────────────────────────────────────────
# All services run in isolated Docker networks.
# The database is NOT exposed outside the backend network.
# The attacker-facing surface is: SSH (2222), HTTP (8080) only.
LAB_ISOLATED=true
